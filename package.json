{
  "name": "msoutlook-mcp",
  "version": "0.1.1",
  "description": "MCP server for classic Outlook on Windows through COM, with polling-based new_mail events",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "msoutlook-mcp": "./dist/msoutlook-mcp"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile dist/msoutlook-mcp src/main.ts",
    "build:windows": "bun build --compile --target=bun-windows-x64 --outfile dist/msoutlook-mcp.exe src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
